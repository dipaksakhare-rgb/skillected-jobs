# Skillected Jobs — environment configuration (copy to .env and adjust)
# Never commit a real .env. In production, set these in the host's dashboard instead.

APP_ENV=development
APP_BASE_URL=http://127.0.0.1:8000
APP_SECRET=change-me-to-a-long-random-string
DATABASE_URL=sqlite:///data/skillected.db
# SQLite | PostgreSQL (schema is Postgres-ready)
DB_ENGINE=sqlite
LOG_LEVEL=INFO

# --- Provider seams (§106). Each has a default no-op implementation. ---
AI_PROVIDER=none            # none | openai_compatible | azure_openai | self_hosted
QUEUE_BACKEND=inline        # inline | redis
STORAGE_BACKEND=local       # local | s3
WHATSAPP_PROVIDER=none      # none | meta_cloud | twilio
ANALYTICS_PROVIDER=internal # internal | plausible | umami

# --- Admin bootstrap (used by the seed script; change in production!) ---
ADMIN_EMAIL=admin@skillected.local
ADMIN_PASSWORD=ChangeMe!Admin1
PLACEMENT_EMAIL=placement@skillected.local
PLACEMENT_PASSWORD=ChangeMe!Officer1

# --- Production checklist (set these when APP_ENV=production) ---
# APP_ENV=production
# APP_BASE_URL=https://your-domain.example
# APP_SECRET=<openssl rand -hex 32>
# ADMIN_PASSWORD=<strong unique password>
# ADMIN_EMAIL=<your real email>
